<Window x:Class="AimSync.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AimSync"
        Width="1180" Height="760"
        MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBackground}"
                BorderBrush="{StaticResource CardBorder}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->
                <StackPanel Grid.Row="0" Margin="22,24,22,18">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="12" Height="12" CornerRadius="6"
                                Background="{StaticResource AccentBrush}"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0" />
                        <TextBlock Text="{Binding AppName}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}" />
                    </StackPanel>
                    <TextBlock Text="{Binding AppVersion}"
                               FontSize="11"
                               Foreground="{StaticResource TextMuted}"
                               Margin="22,-2,0,0" />
                </StackPanel>

                <!-- Navigation -->
                <ListBox Grid.Row="1"
                         Style="{StaticResource NavListStyle}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNavItem}"
                         Margin="14,4,14,0" SelectionChanged="NavList_SelectionChanged" />

                <!-- Footer status -->
                <Border Grid.Row="2"
                        Margin="16,10,16,14"
                        Padding="12,10"
                        CornerRadius="9"
                        BorderBrush="{StaticResource CardBorder}"
                        BorderThickness="1"
                        Background="#0C1117">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0"
                                 Width="8" Height="8"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0"
                                 Fill="{Binding GlobalStatusBrushKey, Converter={StaticResource StatusBrushConverter}}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding GlobalStateText}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="ESTADO"
                                       FontSize="8.5"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ToggleKeyLabel}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Content ============ -->
        <ContentControl x:Name="PageHost"
                        Grid.Column="1"
                        Margin="30,26,28,24"
                        Content="{Binding SelectedPage}"
                        Opacity="1" />
    </Grid>
</Window>