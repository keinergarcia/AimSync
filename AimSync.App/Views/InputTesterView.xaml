<UserControl x:Class="AimSync.App.Views.InputTesterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AimSync.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Probador de entradas" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Canal de captura en tiempo real: Entrada cruda → Sensibilidad → Curva → Salida" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Style="{StaticResource PagePanel}"
                      Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Teclado" Style="{StaticResource CardTitle}" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <controls:ButtonFace IsActive="{Binding Current.W}" Width="42" Height="42" MinWidth="42" MinHeight="42">W</controls:ButtonFace>
                                <controls:ButtonFace IsActive="{Binding Current.A}" Width="42" Height="42" MinWidth="42" MinHeight="42" Margin="8,0,0,0">A</controls:ButtonFace>
                                <controls:ButtonFace IsActive="{Binding Current.S}" Width="42" Height="42" MinWidth="42" MinHeight="42" Margin="8,0,0,0">S</controls:ButtonFace>
                                <controls:ButtonFace IsActive="{Binding Current.D}" Width="42" Height="42" MinWidth="42" MinHeight="42" Margin="8,0,0,0">D</controls:ButtonFace>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Canal del mouse" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Crudo Δ → Escalado (Δ × Sens) → Stick derecho"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,4,0,0" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="ΔX crudo" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Current.MouseDX, StringFormat={}{0:+0;-0;0}}"
                                               Style="{StaticResource MonoText}"
                                               FontSize="18"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="ΔY crudo" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Current.MouseDY, StringFormat={}{0:+0;-0;0}}"
                                               Style="{StaticResource MonoText}"
                                               FontSize="18"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Escalado X" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Current.MouseScaledX, StringFormat={}{0:+0;-0;0}}"
                                               Style="{StaticResource MonoText}"
                                               FontSize="18"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Escalado Y" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Current.MouseScaledY, StringFormat={}{0:+0;-0;0}}"
                                               Style="{StaticResource MonoText}"
                                               FontSize="18"
                                               Margin="10,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,16,0,0" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Sens X" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Current.SensX, StringFormat={}{0:0.00}x}"
                                               Style="{StaticResource MonoText}"
                                               FontSize="15"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Sens Y" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Current.SensY, StringFormat={}{0:0.00}x}"
                                               Style="{StaticResource MonoText}"
                                               FontSize="15"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock Text="Delta máx" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Current.MaxDelta, StringFormat={}{0:0}}"
                                               Style="{StaticResource MonoText}"
                                               FontSize="15"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="Curva" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" />
                                    <TextBlock Text="LINEAL" Style="{StaticResource MonoText}" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,16,0,0" />

                            <TextBlock Text="Prueba rápida de sensibilidad"
                                       Style="{StaticResource SectionLabel}"
                                       Margin="0,14,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="1.0x" Style="{StaticResource GhostButton}"
                                        Command="{Binding SetSensitivityCommand}" CommandParameter="1" />
                                <Button Content="2.0x" Style="{StaticResource GhostButton}"
                                        Command="{Binding SetSensitivityCommand}" CommandParameter="2"
                                        Margin="8,0,0,0" />
                                <Button Content="4.0x" Style="{StaticResource GhostButton}"
                                        Command="{Binding SetSensitivityCommand}" CommandParameter="4"
                                        Margin="8,0,0,0" />
                                <Button Content="8.0x" Style="{StaticResource GhostButton}"
                                        Command="{Binding SetSensitivityCommand}" CommandParameter="8"
                                        Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Sistema" Style="{StaticResource CardTitle}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Margin="0,0,10,0"
                                         Fill="{Binding Current.IsEnabled, Converter={StaticResource BoolStateBrush}}" />
                                <TextBlock Grid.Column="1" Text="Activado (InputManager.IsEnabled)"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Current.IsEnabled}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Current.IsEnabled, Converter={StaticResource BoolStateBrush}}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Margin="0,0,10,0"
                                         Fill="{Binding Current.IsConnected, Converter={StaticResource BoolStateBrush}}" />
                                <TextBlock Grid.Column="1" Text="Mando virtual conectado"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Current.IsConnected}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Current.IsConnected, Converter={StaticResource BoolStateBrush}}" />
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                         Margin="0,0,10,0"
                                         Fill="{Binding Current.IsLoopRunning, Converter={StaticResource BoolStateBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding LoopRateText}"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Current.IsLoopRunning}"
                                           FontSize="12" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Current.IsLoopRunning, Converter={StaticResource BoolStateBrush}}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Botones" Style="{StaticResource CardTitle}" />
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,14,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Margin="0,0,10,0"
                                             Fill="{Binding Current.LeftClick, Converter={StaticResource BoolStateBrush}}" />
                                    <TextBlock Grid.Column="1" Text="Clic izquierdo"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Current.LeftClick, Converter={StaticResource BoolToStateText}}"
                                               FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Current.LeftClick, Converter={StaticResource BoolStateBrush}}" />
                                </Grid>

                                <Grid Grid.Column="1" Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                             Margin="0,0,10,0"
                                             Fill="{Binding Current.RightClick, Converter={StaticResource BoolStateBrush}}" />
                                    <TextBlock Grid.Column="1" Text="Clic derecho"
                                               Foreground="{StaticResource TextSecondary}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Current.RightClick, Converter={StaticResource BoolToStateText}}"
                                               FontSize="12" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Current.RightClick, Converter={StaticResource BoolStateBrush}}" />
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- MANDO VIRTUAL -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Mando virtual" Style="{StaticResource CardTitle}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="STICK IZQUIERDO" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                                <controls:StickVisual Width="96" Height="96" Margin="0,8,0,4"
                                                      X="{Binding Current.Controller.LeftX}"
                                                      Y="{Binding Current.Controller.LeftY}" />
                                <TextBlock HorizontalAlignment="Center">
                                    <Run Text="X " Foreground="{StaticResource TextMuted}" />
                                    <Run Text="{Binding Current.Controller.LeftX, StringFormat={}{0:0.00}}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                    <Run Text="   Y " Foreground="{StaticResource TextMuted}" />
                                    <Run Text="{Binding Current.Controller.LeftY, StringFormat={}{0:0.00}}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="STICK DERECHO" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                                <controls:StickVisual Width="96" Height="96" Margin="0,8,0,4"
                                                      X="{Binding Current.Controller.RightX}"
                                                      Y="{Binding Current.Controller.RightY}" />
                                <TextBlock HorizontalAlignment="Center">
                                    <Run Text="X " Foreground="{StaticResource TextMuted}" />
                                    <Run Text="{Binding Current.Controller.RightX, StringFormat={}{0:0.00}}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                    <Run Text="   Y " Foreground="{StaticResource TextMuted}" />
                                    <Run Text="{Binding Current.Controller.RightY, StringFormat={}{0:0.00}}" Foreground="{StaticResource AccentBrush}" FontFamily="Consolas" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <DockPanel>
                                    <TextBlock Text="LT" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Style="{StaticResource MonoText}" DockPanel.Dock="Right"
                                               Text="{Binding Current.Controller.LeftTriggerLevel, StringFormat={}{0:0.00}}" />
                                </DockPanel>
                                <controls:ValueBar Height="6" Margin="0,6,0,0"
                                                  Value="{Binding Current.Controller.LeftTriggerLevel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <DockPanel>
                                    <TextBlock Text="RT" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Style="{StaticResource MonoText}" DockPanel.Dock="Right"
                                               Text="{Binding Current.Controller.RightTriggerLevel, StringFormat={}{0:0.00}}" />
                                </DockPanel>
                                <controls:ValueBar Height="6" Margin="0,6,0,0"
                                                  Value="{Binding Current.Controller.RightTriggerLevel}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,18,0,0" />

                        <TextBlock Text="BOTONES" Style="{StaticResource SectionLabel}" Margin="0,14,0,10" />
                        <StackPanel Orientation="Horizontal">
                            <controls:ButtonFace Width="40" Height="40" MinWidth="40" MinHeight="40" Round="True"
                                                 IsActive="{Binding Current.Controller.A}">A</controls:ButtonFace>
                            <controls:ButtonFace Width="40" Height="40" MinWidth="40" MinHeight="40" Round="True"
                                                 IsActive="{Binding Current.Controller.B}" Margin="8,0,0,0">B</controls:ButtonFace>
                            <controls:ButtonFace Width="40" Height="40" MinWidth="40" MinHeight="40" Round="True"
                                                 IsActive="{Binding Current.Controller.X}" Margin="8,0,0,0">X</controls:ButtonFace>
                            <controls:ButtonFace Width="40" Height="40" MinWidth="40" MinHeight="40" Round="True"
                                                 IsActive="{Binding Current.Controller.Y}" Margin="8,0,0,0">Y</controls:ButtonFace>
                            <controls:ButtonFace Width="40" Height="40" MinWidth="40" MinHeight="40"
                                                 IsActive="{Binding Current.Controller.LeftShoulder}" Margin="16,0,0,0">LB</controls:ButtonFace>
                            <controls:ButtonFace Width="40" Height="40" MinWidth="40" MinHeight="40"
                                                 IsActive="{Binding Current.Controller.RightShoulder}" Margin="8,0,0,0">RB</controls:ButtonFace>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>