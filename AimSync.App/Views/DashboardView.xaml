<UserControl x:Class="AimSync.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Panel" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Resumen del estado de tu sistema de entrada" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Style="{StaticResource PagePanel}"
                      Margin="0,20,0,0">
            <StackPanel>
                <!-- System banner -->
                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0"
                                 Width="10" Height="10"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"
                                 Fill="{Binding SystemStatusBrushKey, Converter={StaticResource StatusBrushConverter}}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                  Color="#00A8FF" Opacity="0.6" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SystemStateText}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding ProfileName, StringFormat='Perfil · {0}'}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondary}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Cards -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ESTADO DE DISPOSITIVOS -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Estado de dispositivos" Style="{StaticResource CardTitle}" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                         Margin="0,0,10,0"
                                         Fill="{Binding KeyboardStatus, Converter={StaticResource StatusBrushConverter}}" />
                                <TextBlock Grid.Column="1" Text="Teclado"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding KeyboardStatus}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                         Margin="0,0,10,0"
                                         Fill="{Binding MouseStatus, Converter={StaticResource StatusBrushConverter}}" />
                                <TextBlock Grid.Column="1" Text="Mouse"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding MouseStatus}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                                         Margin="0,0,10,0"
                                         Fill="{Binding ControllerStatus, Converter={StaticResource StatusBrushConverter}}" />
                                <TextBlock Grid.Column="1" Text="Mando virtual"
                                           Foreground="{StaticResource TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding ControllerStatus}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- PERFIL ACTUAL -->
                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Perfil actual" Style="{StaticResource CardTitle}" />
                            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,14,0,10">
                                <TextBlock Text="{Binding ProfileName}"
                                           FontSize="30"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" />
                                <TextBlock Text="Usando el mapeo de entradas predeterminado"
                                           FontSize="12"
                                           Foreground="{StaticResource TextMuted}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Row="2"
                                    HorizontalAlignment="Left"
                                    CornerRadius="6"
                                    Background="#14202E"
                                    Padding="10,4">
                                <TextBlock Text="PERFIL DEFAULT"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- SISTEMA -->
                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Sistema" Style="{StaticResource CardTitle}" />
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Motor de entrada"
                                           Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding EngineStatus}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource OkBrush}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Activación global"
                                           Foreground="{StaticResource TextSecondary}" />
                                <Border Grid.Column="1" Style="{StaticResource KeyCap}" MinWidth="40" MinHeight="22" Padding="10,3">
                                    <TextBlock Text="{Binding ToggleKeyLabel}"
                                               Style="{StaticResource MonoText}"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Mando físico"
                                           Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding PhysicalControllerStatus}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Macro"
                                           Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding MacroStatus}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Acciones enviadas"
                                           Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding ActionsSentText}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Errores de salida"
                                           Foreground="{StaticResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Text="{Binding OutputErrorText}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"
                                           TextWrapping="Wrap"
                                           MaxWidth="160" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CONTROL -->
                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Control" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="{Binding LastMessage}"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,12,0,0"
                                       TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="ACTIVAR"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ActivateCommand}" />
                                <Button Content="DESACTIVAR"
                                        Style="{StaticResource DangerButton}"
                                        Command="{Binding DeactivateCommand}"
                                        Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>