<UserControl x:Class="AimSync.App.Views.MouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AimSync.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Mouse" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Cómo se convierte el movimiento del mouse en el stick derecho" Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Style="{StaticResource PagePanel}"
                      Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- SENSIBILIDAD -->
                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Sensibilidad" Style="{StaticResource CardTitle}" />

                        <TextBlock Text="Horizontal (X)" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:AimSlider Grid.Column="0"
                                                Minimum="{Binding SensitivityMinimum}"
                                                Maximum="{Binding SensitivityMaximum}"
                                                SmallChange="0.05"
                                                LargeChange="0.25"
                                                Value="{Binding HorizontalSensitivity, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding HorizontalSensitivity, StringFormat={}{0:0.00}}"
                                       Style="{StaticResource MonoText}"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock Text="Vertical (Y)" Style="{StaticResource SectionLabel}" Margin="0,14,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:AimSlider Grid.Column="0"
                                                Minimum="{Binding SensitivityMinimum}"
                                                Maximum="{Binding SensitivityMaximum}"
                                                SmallChange="0.05"
                                                LargeChange="0.25"
                                                Value="{Binding VerticalSensitivity, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding VerticalSensitivity, StringFormat={}{0:0.00}}"
                                       Style="{StaticResource MonoText}"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,18,0,0" />

                        <TextBlock Text="Zona muerta" Style="{StaticResource SectionLabel}" Margin="0,18,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:AimSlider Grid.Column="0"
                                                Minimum="{Binding DeadzoneMinimum}"
                                                Maximum="{Binding DeadzoneMaximum}"
                                                SmallChange="0.01"
                                                LargeChange="0.05"
                                                Value="{Binding Deadzone, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Deadzone, StringFormat={}{0:0.00}}"
                                       Style="{StaticResource MonoText}"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{StaticResource CardBorder}" Margin="0,18,0,0" />

                        <TextBlock Text="Delta máximo (umbral de deflexión total @1x)"
                                   Style="{StaticResource SectionLabel}"
                                   Margin="0,18,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <controls:AimSlider Grid.Column="0"
                                                Minimum="{Binding MaxDeltaMinimum}"
                                                Maximum="{Binding MaxDeltaMaximum}"
                                                SmallChange="1"
                                                LargeChange="10"
                                                Value="{Binding MouseMaxDelta, Mode=TwoWay}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding MouseMaxDelta, StringFormat={}{0:0}}"
                                       Style="{StaticResource MonoText}"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OPCIONES -->
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Opciones" Style="{StaticResource CardTitle}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Invertir X"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding InvertX, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding InvertXLabel}"
                                       Style="{StaticResource MonoText}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Invertir Y"
                                       Foreground="{StaticResource TextPrimary}"
                                       VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1"
                                      Style="{StaticResource ToggleSwitchStyle}"
                                      IsChecked="{Binding InvertY, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{Binding InvertYLabel}"
                                       Style="{StaticResource MonoText}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- SALIDA DEL MOUSE -->
                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Salida del mouse" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="Valores del stick derecho tras sensibilidad · zona muerta"
                                       FontSize="12"
                                       Foreground="{StaticResource TextMuted}"
                                       Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0">
                                <TextBlock Text="X:" Foreground="{StaticResource TextSecondary}" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MouseOutX}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Consolas"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Y:" Foreground="{StaticResource TextSecondary}" FontSize="16" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding MouseOutY}"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontFamily="Consolas"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>