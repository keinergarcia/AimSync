<UserControl x:Class="AimSync.App.Views.ControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AimSync.App.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Controller" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Detección y representación en tiempo real del mando físico (XInput)"
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Style="{StaticResource PagePanel}"
                      Margin="0,20,0,0">
            <StackPanel>

                <!-- Aviso: API no disponible -->
                <Border Style="{StaticResource Card}"
                        Padding="16,12"
                        Margin="0,0,0,16"
                        Background="#1A140E"
                        BorderBrush="{StaticResource WarnBrush}"
                        Visibility="{Binding IsApiAvailable, Converter={StaticResource InverseBoolToVis}}">
                    <TextBlock TextWrapping="Wrap"
                               Foreground="{StaticResource WarnBrush}"
                               Text="XInput no está disponible en este sistema. No se pueden leer mandos físicos." />
                </Border>

                <!-- =================== Dispositivo =================== -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock Text="Dispositivo físico" Style="{StaticResource CardTitle}" />
                            <Button DockPanel.Dock="Right"
                                    Content="REFRESCAR"
                                    Style="{StaticResource GhostButton}"
                                    Padding="12,6"
                                    FontSize="12"
                                    Command="{Binding RefreshCommand}" />
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Seleccionar mando" Style="{StaticResource SectionLabel}" />
                                <ComboBox Margin="0,8,0,0"
                                          HorizontalAlignment="Left"
                                          Style="{StaticResource DeviceComboBox}"
                                          ItemContainerStyle="{StaticResource DeviceComboItem}"
                                          ItemsSource="{Binding Devices}"
                                          SelectedItem="{Binding SelectedDevice}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock Text="{Binding DeviceCountText}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="12"
                                           Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- Estado -->
                            <StackPanel Grid.Column="2" Margin="28,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Estado" Style="{StaticResource SectionLabel}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="11" Height="11" VerticalAlignment="Center"
                                             Margin="0,0,9,0"
                                             Fill="{Binding Current.StatusText, Converter={StaticResource StatusBrushConverter}}" />
                                    <TextBlock Text="{Binding Current.StatusText}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- Datos -->
                        <Grid Grid.Row="2" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource KeyCap}" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="API DE ENTRADA" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding Current.ApiName}" Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource KeyCap}" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="SLOT XINPUT" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding Current.Index}" Style="{StaticResource MonoText}"
                                               FontSize="15" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="4" Style="{StaticResource KeyCap}" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="FRECUENCIA DE REPORTE" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Style="{StaticResource MonoText}" FontSize="15"
                                               Text="{Binding Current.UpdateRateHz, StringFormat={}{0:0} Hz}"
                                               Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- =================== Mando visual =================== -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="Mando" Style="{StaticResource CardTitle}" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Current.DeviceName}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center" />
                        </DockPanel>

                        <Border Margin="0,16,0,0" CornerRadius="26" Padding="22,18"
                                BorderThickness="1" BorderBrush="{StaticResource CardBorder}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#1E2530" Offset="0" />
                                    <GradientStop Color="#151A22" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Gatillos -->
                                <StackPanel Grid.Row="0" Grid.Column="0">
                                    <DockPanel>
                                        <TextBlock Text="LT" Style="{StaticResource SectionLabel}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource MonoText}"
                                                   Text="{Binding Current.LeftTriggerLevel, StringFormat={}{0:P0}}" />
                                    </DockPanel>
                                    <controls:ValueBar Height="8" Margin="0,6,0,0"
                                                       Value="{Binding Current.LeftTriggerLevel}" />
                                </StackPanel>

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Text="AIMSYNC"
                                           Foreground="{StaticResource TextMuted}"
                                           FontSize="11" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="24,0" />

                                <StackPanel Grid.Row="0" Grid.Column="4">
                                    <DockPanel>
                                        <TextBlock Text="RT" Style="{StaticResource SectionLabel}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Style="{StaticResource MonoText}"
                                                   Text="{Binding Current.RightTriggerLevel, StringFormat={}{0:P0}}" />
                                    </DockPanel>
                                    <controls:ValueBar Height="8" Margin="0,6,0,0"
                                                       Value="{Binding Current.RightTriggerLevel}" />
                                </StackPanel>

                                <!-- Bumpers + centro -->
                                <controls:ButtonFace Grid.Row="1" Grid.Column="0"
                                                     HorizontalAlignment="Left" Margin="0,14,0,0"
                                                     IsActive="{Binding Current.LeftShoulder}">LB</controls:ButtonFace>

                                <StackPanel Grid.Row="1" Grid.Column="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="24,14,24,0">
                                    <controls:ButtonFace IsActive="{Binding Current.View}"
                                                         MinWidth="36" Width="36" Height="36" FontSize="11"
                                                         ToolTip="View">V</controls:ButtonFace>
                                    <controls:ButtonFace Round="True" Margin="8,0"
                                                         IsActive="{Binding Current.Nexus}"
                                                         ToolTip="Guide">◎</controls:ButtonFace>
                                    <controls:ButtonFace IsActive="{Binding Current.Menu}"
                                                         MinWidth="36" Width="36" Height="36" FontSize="11"
                                                         ToolTip="Menu">M</controls:ButtonFace>
                                </StackPanel>

                                <controls:ButtonFace Grid.Row="1" Grid.Column="4"
                                                     HorizontalAlignment="Right" Margin="0,14,0,0"
                                                     IsActive="{Binding Current.RightShoulder}">RB</controls:ButtonFace>

                                <!-- Stick izquierdo -->
                                <StackPanel Grid.Row="2" Grid.Column="0"
                                            HorizontalAlignment="Center" Margin="0,22,0,0">
                                    <controls:StickVisual Width="132" Height="132"
                                                          X="{Binding Current.LeftX}"
                                                          Y="{Binding Current.LeftY}" />
                                    <TextBlock Text="LS" HorizontalAlignment="Center" Margin="0,8,0,0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding Current.LeftStick, Converter={StaticResource BoolStateBrush}}" />
                                </StackPanel>

                                <!-- Cruceta -->
                                <StackPanel Grid.Row="2" Grid.Column="1"
                                            HorizontalAlignment="Center" Margin="20,22,20,0">
                                    <TextBlock Text="CRUZ" Style="{StaticResource SectionLabel}"
                                               HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:ButtonFace Grid.Row="0" Grid.Column="1"
                                                             IsActive="{Binding Current.DPadUp}">▲</controls:ButtonFace>
                                        <controls:ButtonFace Grid.Row="1" Grid.Column="0"
                                                             IsActive="{Binding Current.DPadLeft}">◀</controls:ButtonFace>
                                        <controls:ButtonFace Grid.Row="1" Grid.Column="2"
                                                             IsActive="{Binding Current.DPadRight}">▶</controls:ButtonFace>
                                        <controls:ButtonFace Grid.Row="2" Grid.Column="1"
                                                             IsActive="{Binding Current.DPadDown}">▼</controls:ButtonFace>
                                    </Grid>
                                </StackPanel>

                                <!-- Botones A B X Y (colores Xbox) -->
                                <StackPanel Grid.Row="2" Grid.Column="3"
                                            HorizontalAlignment="Center" Margin="20,22,20,0">
                                    <TextBlock Text="ABXY" Style="{StaticResource SectionLabel}"
                                               HorizontalAlignment="Center" Margin="0,0,0,10" />
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:ButtonFace Grid.Row="0" Grid.Column="1" Round="True"
                                                             Foreground="#D29922"
                                                             IsActive="{Binding Current.Y}">Y</controls:ButtonFace>
                                        <controls:ButtonFace Grid.Row="1" Grid.Column="0" Round="True"
                                                             Foreground="#00A8FF"
                                                             IsActive="{Binding Current.X}">X</controls:ButtonFace>
                                        <controls:ButtonFace Grid.Row="1" Grid.Column="2" Round="True"
                                                             Foreground="#F85149"
                                                             IsActive="{Binding Current.B}">B</controls:ButtonFace>
                                        <controls:ButtonFace Grid.Row="2" Grid.Column="1" Round="True"
                                                             Foreground="#3FB950"
                                                             IsActive="{Binding Current.A}">A</controls:ButtonFace>
                                    </Grid>
                                </StackPanel>

                                <!-- Stick derecho -->
                                <StackPanel Grid.Row="2" Grid.Column="4"
                                            HorizontalAlignment="Center" Margin="0,22,0,0">
                                    <controls:StickVisual Width="132" Height="132"
                                                          X="{Binding Current.RightX}"
                                                          Y="{Binding Current.RightY}" />
                                    <TextBlock Text="RS" HorizontalAlignment="Center" Margin="0,8,0,0"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{Binding Current.RightStick, Converter={StaticResource BoolStateBrush}}" />
                                 </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- =================== Diagnóstico =================== -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Diagnóstico de entradas" Style="{StaticResource CardTitle}" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Sticks -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Sticks (normalizado / crudo)" Style="{StaticResource SectionLabel}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Izq"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MonoText}"
                                               Text="{Binding Current.LeftX, StringFormat={}{0:+0.00;-0.00; 0.00}}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource MonoText}"
                                               Text="{Binding Current.LeftY, StringFormat={}{0:+0.00;-0.00; 0.00}}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Foreground="{StaticResource TextMuted}"
                                               FontFamily="Consolas" FontSize="12" HorizontalAlignment="Right"
                                               Text="{Binding Current.RawLeftX, StringFormat='X {0}'}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Der"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MonoText}"
                                               Text="{Binding Current.RightX, StringFormat={}{0:+0.00;-0.00; 0.00}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource MonoText}"
                                               Text="{Binding Current.RightY, StringFormat={}{0:+0.00;-0.00; 0.00}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="3" Foreground="{StaticResource TextMuted}"
                                               FontFamily="Consolas" FontSize="12" HorizontalAlignment="Right"
                                               Text="{Binding Current.RawRightX, StringFormat='X {0}'}" />
                                </Grid>
                            </StackPanel>

                            <!-- Gatillos -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gatillos (normalizado / crudo)" Style="{StaticResource SectionLabel}" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="8" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="LT"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource MonoText}"
                                               Text="{Binding Current.LeftTriggerLevel, StringFormat={}{0:P0}}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Foreground="{StaticResource TextMuted}"
                                               FontFamily="Consolas" FontSize="12"
                                               Text="{Binding Current.RawLeftTrigger}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="RT"
                                               Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource MonoText}"
                                               Text="{Binding Current.RightTriggerLevel, StringFormat={}{0:P0}}" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Foreground="{StaticResource TextMuted}"
                                               FontFamily="Consolas" FontSize="12"
                                               Text="{Binding Current.RawRightTrigger}" />
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cruceta"
                                       Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource MonoText}"
                                       Text="{Binding Current.DPadDirection}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Botones pulsados"
                                       Foreground="{StaticResource TextSecondary}" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource MonoText}"
                                       Text="{Binding Current.PressedButtonsText}" TextWrapping="Wrap" />
                        </Grid>

                        <Border Margin="0,18,0,0" Padding="12,10" CornerRadius="8"
                                Background="{StaticResource InputBackground}"
                                BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                            <TextBlock TextWrapping="Wrap"
                                       Foreground="{StaticResource TextMuted}"
                                       FontSize="12"
                                       Text="Pulsa cada control del GameSir y comprueba que el elemento correspondiente del mando se ilumina o se mueve. Los valores de arriba son los reales que entrega XInput, sin transformar." />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- =================== Salida virtual (heredada) =================== -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Salida del mando virtual (heredada)" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="Estado que AimSync escribe en el mando virtual Xbox 360 cuando está activado."
                                   Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,4,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Stick izquierdo" Style="{StaticResource SectionLabel}" />
                                <TextBlock Style="{StaticResource MonoText}" Margin="0,6,0,0"
                                           Text="{Binding VirtualOutput.LeftX, StringFormat=X {0:+0.00;-0.00; 0.00}}" />
                                <TextBlock Style="{StaticResource MonoText}"
                                           Text="{Binding VirtualOutput.LeftY, StringFormat=Y {0:+0.00;-0.00; 0.00}}" />
                                <TextBlock Text="Stick derecho" Style="{StaticResource SectionLabel}" Margin="0,12,0,0" />
                                <TextBlock Style="{StaticResource MonoText}" Margin="0,6,0,0"
                                           Text="{Binding VirtualOutput.RightX, StringFormat=X {0:+0.00;-0.00; 0.00}}" />
                                <TextBlock Style="{StaticResource MonoText}"
                                           Text="{Binding VirtualOutput.RightY, StringFormat=Y {0:+0.00;-0.00; 0.00}}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Gatillos" Style="{StaticResource SectionLabel}" />
                                <TextBlock Style="{StaticResource MonoText}" Margin="0,6,0,0"
                                           Text="{Binding VirtualOutput.LeftTriggerLevel, StringFormat=LT {0:P0}}" />
                                <TextBlock Style="{StaticResource MonoText}"
                                           Text="{Binding VirtualOutput.RightTriggerLevel, StringFormat=RT {0:P0}}" />
                                <TextBlock Text="Botones" Style="{StaticResource SectionLabel}" Margin="0,12,0,0" />
                                <TextBlock Style="{StaticResource MonoText}" Margin="0,6,0,0" TextWrapping="Wrap"
                                           Text="A/B/X/Y · LB/RB · Cruz" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
